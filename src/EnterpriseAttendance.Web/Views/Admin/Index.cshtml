@{
    ViewData["Title"] = "Admin Dashboard";
}

<!-- Enterprise Command Banner (Double-Layered Ocean Frame) -->
<div class="card" style="background: linear-gradient(135deg, rgba(6, 20, 48, 0.95) 0%, rgba(10, 25, 47, 0.95) 100%); border-left: 6px solid #00E5FF; padding: 2rem; box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(0, 229, 255, 0.25);">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.2rem;">
        <div>
            <div style="font-size: 0.8rem; font-weight: 800; color: #00E5FF; text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 0.4rem;">
                <i class="fa-solid fa-building-user" style="margin-right: 0.35rem;"></i> Executive Command Center
            </div>
            <h2 style="font-size: 1.75rem; font-weight: 800; color: #fff; letter-spacing: -0.02em;">Bkran Group Connect — Executive Console</h2>
            <p style="color: var(--text-sub); font-size: 0.92rem; margin-top: 0.35rem;">Branch-by-Branch Organization Hierarchy & Full Telemetry Attendance Inspection</p>
        </div>
        <div style="display: flex; gap: 0.85rem; align-items: center; flex-wrap: wrap;">
            <a href="/Manager" class="btn btn-primary" style="font-size: 0.85rem; padding: 0.65rem 1.1rem; text-decoration: none;">
                <i class="fa-solid fa-user-shield"></i> Switch to Manager Console
            </a>
            <span class="badge badge-success" style="padding: 0.55rem 1rem; font-size: 0.82rem;"><i class="fa-solid fa-earth-asia"></i> Scope: India Regional Offices</span>
            <span class="badge badge-warning" style="padding: 0.55rem 1rem; font-size: 0.82rem;"><i class="fa-solid fa-shield-halved"></i> Executive Admin</span>
        </div>
    </div>
</div>

<!-- Executive Metric KPI Cards (Ocean-Tick Glass Panels) -->
<div class="grid" style="grid-template-columns: repeat(3, 1fr); gap: 1.6rem;">
    <div class="card" style="margin-bottom: 0; padding: 1.6rem; border-top: 4px solid #3B82F6; background: linear-gradient(135deg, rgba(15, 32, 67, 0.7) 0%, rgba(6, 16, 36, 0.8) 100%);">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <div style="color: var(--text-sub); font-size: 0.82rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">Total Managed Workforce</div>
                <div style="font-size: 1.85rem; font-weight: 800; color: #fff; margin-top: 0.35rem;">18,450</div>
                <div style="font-size: 0.78rem; color: #34D399; margin-top: 0.25rem;"><i class="fa-solid fa-check-double"></i> All India Regional Offices Synced</div>
            </div>
            <div style="width: 52px; height: 52px; border-radius: 16px; background: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.3); display: flex; align-items: center; justify-content: center; color: #3B82F6; font-size: 1.4rem; box-shadow: 0 4px 15px rgba(59, 130, 246, 0.2);">
                <i class="fa-solid fa-users"></i>
            </div>
        </div>
    </div>

    <div class="card" style="margin-bottom: 0; padding: 1.6rem; border-top: 4px solid #10B981; background: linear-gradient(135deg, rgba(6, 28, 40, 0.7) 0%, rgba(6, 16, 36, 0.8) 100%);">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <div style="color: var(--text-sub); font-size: 0.82rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">Hybrid Policy Compliance Rate</div>
                <div style="font-size: 1.85rem; font-weight: 800; color: #fff; margin-top: 0.35rem;">86.4%</div>
                <div style="font-size: 0.78rem; color: #34D399; margin-top: 0.25rem;"><i class="fa-solid fa-arrow-trend-up"></i> Target 3 Days/Week Office Goal Met</div>
            </div>
            <div style="width: 52px; height: 52px; border-radius: 16px; background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); display: flex; align-items: center; justify-content: center; color: #10B981; font-size: 1.4rem; box-shadow: 0 4px 15px rgba(16, 185, 129, 0.2);">
                <i class="fa-solid fa-chart-line"></i>
            </div>
        </div>
    </div>

    <div class="card" style="margin-bottom: 0; padding: 1.6rem; border-top: 4px solid #00E5FF; background: linear-gradient(135deg, rgba(6, 24, 48, 0.7) 0%, rgba(6, 16, 36, 0.8) 100%);">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <div style="color: var(--text-sub); font-size: 0.82rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">Intune & Defender Managed</div>
                <div style="font-size: 1.85rem; font-weight: 800; color: #fff; margin-top: 0.35rem;">100%</div>
                <div style="font-size: 0.78rem; color: #00E5FF; margin-top: 0.25rem;"><i class="fa-solid fa-shield-halved"></i> Active Telemetry Guard</div>
            </div>
            <div style="width: 52px; height: 52px; border-radius: 16px; background: rgba(0, 229, 255, 0.15); border: 1px solid rgba(0, 229, 255, 0.3); display: flex; align-items: center; justify-content: center; color: #00E5FF; font-size: 1.4rem; box-shadow: 0 4px 15px rgba(0, 229, 255, 0.2);">
                <i class="fa-solid fa-laptop-code"></i>
            </div>
        </div>
    </div>
</div>

<!-- Department & Manager Filters (Ocean Control Bar) -->
<div class="card" style="padding: 1.4rem; border: 1px solid rgba(0, 229, 255, 0.2); background: linear-gradient(135deg, rgba(10, 25, 47, 0.9) 0%, rgba(6, 16, 36, 0.9) 100%);">
    <div style="display: flex; gap: 1.8rem; align-items: center; flex-wrap: wrap;">
        <div>
            <label style="font-size: 0.82rem; color: var(--accent-cyan); display: block; margin-bottom: 0.45rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">
                <i class="fa-solid fa-building" style="margin-right: 0.3rem;"></i> Filter Org Tree by Department:
            </label>
            <select id="deptFilter" onchange="onFilterChange()" style="padding: 0.7rem 1rem; background: rgba(3, 8, 22, 0.85); border: 1px solid var(--card-border); border-radius: 10px; color: #fff; font-size: 0.92rem; min-width: 250px; outline: none; transition: border-color 0.25s;" onfocus="this.style.borderColor='#00E5FF'" onblur="this.style.borderColor='var(--card-border)'">
                <option value="ALL">All Departments (Full Organization)</option>
                <option value="Software Engineering">Software Engineering</option>
                <option value="IT Infrastructure & Security">IT Infrastructure & Security</option>
                <option value="Human Resources">Human Resources</option>
                <option value="Sales & Business Development">Sales & Business Development</option>
                <option value="Executive Leadership">Executive Leadership</option>
            </select>
        </div>

        <div>
            <label style="font-size: 0.82rem; color: var(--accent-cyan); display: block; margin-bottom: 0.45rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">
                <i class="fa-solid fa-magnifying-glass" style="margin-right: 0.3rem;"></i> Re-Root Tree by Manager Name:
            </label>
            <div style="display: flex; gap: 0.6rem;">
                <input type="text" id="managerInput" placeholder="e.g. Rajesh Sharma, Sarah Connor, Kwame..." style="padding: 0.7rem 1rem; background: rgba(3, 8, 22, 0.85); border: 1px solid var(--card-border); border-radius: 10px; color: #fff; font-size: 0.92rem; width: 300px; outline: none; transition: border-color 0.25s;" onfocus="this.style.borderColor='#00E5FF'" onblur="this.style.borderColor='var(--card-border)'" />
                <button onclick="onFilterChange()" class="btn btn-primary" style="padding: 0.7rem 1.25rem;"><i class="fa-solid fa-filter"></i> Apply Root</button>
                <button onclick="resetFilters()" class="btn btn-secondary" style="padding: 0.7rem 1rem;"><i class="fa-solid fa-rotate-left"></i> Reset</button>
            </div>
        </div>
    </div>
</div>

<!-- Section 1: Branch-by-Branch Interactive Org Tree -->
<div class="card">
    <div class="card-header">
        <div class="card-title"><i class="fa-solid fa-sitemap" style="color: #00E5FF;"></i> Teams-Style Branch Hierarchy Tree (Click [+] to Expand Sub-Branches)</div>
        <span class="badge badge-success"><i class="fa-solid fa-shield-check"></i> Auto-Synced via Entra ID</span>
    </div>
    
    <div style="padding: 1.6rem; background: rgba(3, 8, 22, 0.75); border-radius: 14px; border: 1px solid var(--card-border); overflow-x: auto; min-height: 180px;">
        <div id="orgChartTreeContainer">
            <div style="color: var(--text-muted);"><i class="fa-solid fa-spinner fa-spin" style="color: #00E5FF;"></i> Building Org Branch Tree...</div>
        </div>
    </div>
</div>

<!-- Section 2: Expandable Direct Reporting Table -->
<div class="card" id="subordinatesCard" style="border-top: 4px solid #10B981;">
    <div class="card-header">
        <div class="card-title" id="selectedManagerHeader">
            <i class="fa-solid fa-user-tie" style="color: #10B981;"></i> Direct Reports of <span id="currentManagerName" style="color: #00E5FF;">Rajesh Sharma</span> (Click Inspect for Full Telemetry)
        </div>
        <span class="badge badge-success" id="subordinateCountBadge">Direct Reports Level-1</span>
    </div>

    <!-- Table -->
    <table id="subordinatesTable">
        <thead>
            <tr>
                <th style="width: 45px;"></th>
                <th>Employee Name</th>
                <th>Title</th>
                <th>Department</th>
                <th>Office Location</th>
                <th>First Seen (Connect)</th>
                <th>Last Seen (Disconnect)</th>
                <th>Net Hours</th>
                <th>Days in Office</th>
                <th>Inspect Action</th>
            </tr>
        </thead>
        <tbody id="subordinatesBody">
            <!-- Loaded dynamically -->
        </tbody>
    </table>
</div>

<!-- User Full Attendance Inspecting Modal -->
<div id="userModal" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.85); backdrop-filter: blur(16px); z-index: 2000; justify-content: center; align-items: center; padding: 1.5rem;">
    <div class="card" style="width: 950px; max-width: 95vw; max-height: 90vh; overflow-y: auto; background: rgba(6, 16, 36, 0.95); border: 1px solid #00E5FF; box-shadow: 0 20px 60px rgba(0,229,255,0.3);">
        <div class="card-header">
            <div class="card-title" id="modalUserName" style="color: #00E5FF; font-size: 1.2rem;"><i class="fa-solid fa-microscope"></i> Employee Attendance Inspection Panel</div>
            <button onclick="closeUserModal()" class="btn btn-secondary" style="padding: 0.35rem 0.85rem;">&times; Close Inspection</button>
        </div>
        <div id="modalUserContent" style="padding-top: 0.5rem;">
            <!-- Loaded dynamically -->
        </div>
    </div>
</div>

<script>
    let activeManagerId = 1;

    document.addEventListener("DOMContentLoaded", function () {
        loadOrgTree();
        loadDirectReports(activeManagerId, "Rajesh Sharma", "subordinatesBody");
    });

    async function onFilterChange() {
        const dept = document.getElementById('deptFilter').value;
        const mgrName = document.getElementById('managerInput').value.trim();

        try {
            const url = `/api/admin/org-chart-filter?department=${encodeURIComponent(dept)}&managerName=${encodeURIComponent(mgrName)}`;
            const res = await fetch(url);
            const tree = await res.json();
            
            const container = document.getElementById('orgChartTreeContainer');
            if (!tree) {
                container.innerHTML = '<div style="color: var(--accent-amber); padding: 1rem;"><i class="fa-solid fa-triangle-exclamation"></i> No manager found matching that criteria.</div>';
                return;
            }
            container.innerHTML = renderOrgNode(tree);
            selectManager(tree.id, tree.fullName);
        } catch (e) {
            console.error('Error filtering org tree:', e);
        }
    }

    function resetFilters() {
        document.getElementById('deptFilter').value = 'ALL';
        document.getElementById('managerInput').value = '';
        onFilterChange();
    }

    async function loadOrgTree() {
        onFilterChange();
    }

    function renderOrgNode(node) {
        if (!node) return '';

        let reportsHtml = '';
        if (node.directReports && node.directReports.length > 0) {
            reportsHtml = `<div id="branch-child-${node.id}" style="margin-left: 2.2rem; border-left: 2px dashed rgba(0, 229, 255, 0.25); padding-left: 1.2rem; display: flex; flex-direction: column; gap: 0.75rem; margin-top: 0.75rem;">`;
            node.directReports.forEach(child => {
                reportsHtml += renderOrgNode(child);
            });
            reportsHtml += '</div>';
        }

        const isSelected = (node.id === activeManagerId);
        const borderStyle = isSelected ? 'border: 2px solid #00E5FF; background: rgba(0, 229, 255, 0.15); box-shadow: 0 0 20px rgba(0,229,255,0.35);' : 'border: 1px solid var(--card-border); background: rgba(10, 25, 47, 0.85);';
        
        const hasChildren = (node.directReports && node.directReports.length > 0);
        const expandBtn = hasChildren ? `<button onclick="toggleBranchNode(${node.id}, event)" class="btn btn-secondary" style="padding: 0.25rem 0.65rem; font-size: 0.76rem; border-color: #00E5FF; color: #00E5FF;">[+] Sub-Branch</button>` : '';

        return `
            <div style="margin-bottom: 0.45rem;">
                <div onclick="selectManager(${node.id}, '${node.fullName.replace("'", "\\'")}')" style="display: inline-flex; align-items: center; gap: 0.85rem; ${borderStyle} padding: 0.75rem 1.25rem; border-radius: 14px; cursor: pointer; transition: all 0.25s ease;" onmouseover="this.style.borderColor='#00E5FF'" onmouseout="if(${node.id} !== activeManagerId) this.style.borderColor='var(--card-border)'">
                    <i class="fa-solid fa-user-tie" style="color: #00E5FF; font-size: 1.2rem;"></i>
                    <div>
                        <div style="font-weight: 700; color: #fff; font-size: 0.98rem;">${node.fullName}</div>
                        <div style="font-size: 0.8rem; color: var(--text-sub);">${node.title} • ${node.department}</div>
                    </div>
                    <span class="badge badge-success" style="margin-left: 0.75rem; font-size: 0.72rem;">3/3 Office Days [MET]</span>
                    ${expandBtn}
                    <button onclick="inspectUser(${node.id}, event)" class="btn btn-primary" style="padding: 0.3rem 0.7rem; font-size: 0.78rem; margin-left: 0.4rem;"><i class="fa-solid fa-microscope"></i> Inspect Tracking</button>
                </div>
                ${reportsHtml}
            </div>
        `;
    }

    function toggleBranchNode(nodeId, evt) {
        evt.stopPropagation();
        const childContainer = document.getElementById(`branch-child-${nodeId}`);
        if (childContainer) {
            childContainer.style.display = (childContainer.style.display === 'none') ? 'flex' : 'none';
        }
    }

    function selectManager(managerId, managerName) {
        activeManagerId = managerId;
        loadDirectReports(managerId, managerName, "subordinatesBody");
    }

    async function loadDirectReports(managerId, managerName, targetTbodyId) {
        try {
            if (targetTbodyId === "subordinatesBody") {
                document.getElementById('currentManagerName').innerText = managerName;
            }

            const res = await fetch('/api/admin/direct-reports/' + managerId);
            const reports = await res.json();

            const tbody = document.getElementById(targetTbodyId);
            tbody.innerHTML = '';

            if (reports.length === 0) {
                tbody.innerHTML = '<tr><td colspan="10" style="text-align:center; color: var(--text-muted); padding: 1rem;">No direct reports found for this manager.</td></tr>';
                return;
            }

            reports.forEach(u => {
                const statusBadge = u.status === 'MET' 
                    ? '<span class="badge badge-success">MET (12+ Days/Mo)</span>'
                    : '<span class="badge badge-warning">PARTIAL</span>';

                const expandBtn = u.hasSubordinates 
                    ? `<button onclick="toggleExpandRow(${u.id}, '${u.fullName.replace("'", "\\'")}', this)" class="btn btn-secondary" style="padding: 0.2rem 0.55rem; font-size: 0.78rem; border-color: #00E5FF; color: #00E5FF;">[+] Sub-Branch</button>`
                    : '<span style="color: var(--text-muted); font-size: 0.75rem;">—</span>';

                const tr = document.createElement('tr');
                tr.id = `user-row-${u.id}`;
                tr.innerHTML = `
                    <td style="text-align: center;">${expandBtn}</td>
                    <td><strong>${u.fullName}</strong></td>
                    <td>${u.title}</td>
                    <td>${u.department}</td>
                    <td>${u.officeLocation}</td>
                    <td><strong style="color: #60A5FA;">${u.firstSeen}</strong></td>
                    <td><strong style="color: #FBBF24;">${u.lastSeen}</strong></td>
                    <td><strong>${u.totalOfficeHours} hrs</strong></td>
                    <td><strong>${u.officeDaysCount} Days</strong></td>
                    <td>
                        <button onclick="inspectUser(${u.id}, event)" class="btn btn-primary" style="padding: 0.35rem 0.8rem; font-size: 0.8rem;">
                            <i class="fa-solid fa-microscope"></i> Inspect Tracking
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);

                if (u.hasSubordinates) {
                    const subTr = document.createElement('tr');
                    subTr.id = `sub-row-${u.id}`;
                    subTr.style.display = 'none';
                    subTr.innerHTML = `
                        <td colspan="10" style="padding: 0.85rem 1.5rem; background: rgba(3, 8, 22, 0.95); border-left: 4px solid #00E5FF;">
                            <div style="font-weight: 700; color: #00E5FF; margin-bottom: 0.5rem; font-size: 0.85rem;">
                                <i class="fa-solid fa-sitemap"></i> Subordinate Reports under ${u.fullName}
                            </div>
                            <table style="margin-bottom: 0;">
                                <thead>
                                    <tr>
                                        <th style="width: 45px;"></th>
                                        <th>Employee Name</th>
                                        <th>Title</th>
                                        <th>Department</th>
                                        <th>Office Location</th>
                                        <th>First Seen</th>
                                        <th>Last Seen</th>
                                        <th>Hours</th>
                                        <th>Days</th>
                                        <th>Inspect Action</th>
                                    </tr>
                                </thead>
                                <tbody id="sub-tbody-${u.id}">
                                    <tr><td colspan="10" style="text-align:center; color: var(--text-muted);">Loading sub-branch...</td></tr>
                                </tbody>
                            </table>
                        </td>
                    `;
                    tbody.appendChild(subTr);
                }
            });
        } catch (e) {
            console.error('Error loading direct reports:', e);
        }
    }

    async function toggleExpandRow(subManagerId, subManagerName, btn) {
        const subRow = document.getElementById(`sub-row-${subManagerId}`);
        if (!subRow) return;

        if (subRow.style.display === 'none') {
            subRow.style.display = 'table-row';
            btn.innerHTML = '[-] Collapse';
            btn.style.borderColor = '#EF4444';
            btn.style.color = '#F87171';
            await loadDirectReports(subManagerId, subManagerName, `sub-tbody-${subManagerId}`);
        } else {
            subRow.style.display = 'none';
            btn.innerHTML = '[+] Sub-Branch';
            btn.style.borderColor = '#00E5FF';
            btn.style.color = '#00E5FF';
        }
    }

    async function inspectUser(employeeId, event) {
        if (event) event.stopPropagation();
        try {
            const res = await fetch('/api/attendance/user-details/' + employeeId);
            const data = await res.json();

            const emp = data.employee;
            const metrics = data.metrics;

            let historyHtml = '';
            data.dailyHistory.forEach(h => {
                const typeBadge = h.type === 'Office'
                    ? '<span class="badge badge-success"><i class="fa-solid fa-building"></i> Office</span>'
                    : '<span class="badge badge-warning"><i class="fa-solid fa-house-laptop"></i> WFH</span>';

                historyHtml += `
                    <tr>
                        <td><strong>${h.date} (${h.dayOfWeek})</strong></td>
                        <td>${typeBadge}</td>
                        <td><strong style="color: #60A5FA;">${h.firstSeen}</strong></td>
                        <td><strong style="color: #FBBF24;">${h.lastSeen}</strong></td>
                        <td><strong>${h.hours} hrs</strong></td>
                        <td>${h.officeLocation}</td>
                    </tr>
                `;
            });

            const content = document.getElementById('modalUserContent');
            content.innerHTML = `
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 1px solid var(--card-border); padding-bottom: 1rem;">
                    <div>
                        <div style="font-size: 0.8rem; font-weight: 800; color: #00E5FF; text-transform: uppercase;">
                            <i class="fa-solid fa-microscope"></i> Employee Telemetry & Attendance Inspection
                        </div>
                        <h2 style="font-size: 1.6rem; font-weight: 800; color: #fff; margin-top: 0.2rem;">${emp.fullName}</h2>
                        <p style="color: var(--text-sub); font-size: 0.9rem;">${emp.title} | ${emp.department} | ${emp.officeLocation}</p>
                    </div>
                    <span class="badge badge-success" style="font-size: 0.85rem; padding: 0.6rem 1.1rem;">
                        <i class="fa-solid fa-shield-check"></i> ${emp.complianceStatus} Intune Device
                    </span>
                </div>

                <div class="grid" style="grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 1.5rem;">
                    <div style="background: rgba(3,8,22,0.8); border: 1px solid var(--card-border); padding: 1.1rem; border-radius: 12px;">
                        <div style="color: var(--text-sub); font-size: 0.78rem; font-weight: 700; text-transform: uppercase;">Office Days (14 Days)</div>
                        <div style="font-size: 1.5rem; font-weight: 800; color: #34D399; margin-top: 0.2rem;">${metrics.officeDaysCount} Days</div>
                    </div>
                    <div style="background: rgba(3,8,22,0.8); border: 1px solid var(--card-border); padding: 1.1rem; border-radius: 12px;">
                        <div style="color: var(--text-sub); font-size: 0.78rem; font-weight: 700; text-transform: uppercase;">WFH Days</div>
                        <div style="font-size: 1.5rem; font-weight: 800; color: #FBBF24; margin-top: 0.2rem;">${metrics.wfhDaysCount} Days</div>
                    </div>
                    <div style="background: rgba(3,8,22,0.8); border: 1px solid var(--card-border); padding: 1.1rem; border-radius: 12px;">
                        <div style="color: var(--text-sub); font-size: 0.78rem; font-weight: 700; text-transform: uppercase;">Total Net Office Hours</div>
                        <div style="font-size: 1.5rem; font-weight: 800; color: #60A5FA; margin-top: 0.2rem;">${metrics.totalOfficeHours} hrs</div>
                    </div>
                    <div style="background: rgba(3,8,22,0.8); border: 1px solid var(--card-border); padding: 1.1rem; border-radius: 12px;">
                        <div style="color: var(--text-sub); font-size: 0.78rem; font-weight: 700; text-transform: uppercase;">Hybrid Policy Status</div>
                        <div style="font-size: 1.1rem; font-weight: 800; color: #fff; margin-top: 0.3rem;">${metrics.complianceStatus}</div>
                    </div>
                </div>

                <div style="font-weight: 700; color: #fff; margin-bottom: 0.8rem; font-size: 1.05rem;">
                    <i class="fa-solid fa-clock-rotate-left" style="color: #00E5FF;"></i> Date-by-Date Network Connect (First Seen) & Disconnect (Last Seen) Timeline
                </div>

                <table>
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Attendance Type</th>
                            <th>First Seen (Network Connect)</th>
                            <th>Last Seen (Network Disconnect)</th>
                            <th>Net Working Hours</th>
                            <th>Network Location</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${historyHtml}
                    </tbody>
                </table>
            `;

            document.getElementById('userModal').style.display = 'flex';
        } catch (e) {
            console.error('Error inspecting user:', e);
        }
    }

    function closeUserModal() {
        document.getElementById('userModal').style.display = 'none';
    }
</script>
