<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bkran Group Connect (Microsoft Ecosystem Standard)</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Segoe+UI:ital,wght@0,400;0,600;0,700;1,400&family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <style>
        :root {
            /* Microsoft Fluent & Defender Enterprise Color Palette */
            --ms-navy-dark: #0B132B;
            --ms-navy-card: #111C38;
            --ms-navy-surface: #1C2951;
            --ms-fluent-blue: #0078D4;
            --ms-fluent-blue-hover: #106EBE;
            --ms-cyan: #00A4EF;
            --ms-green-emerald: #107C41;
            --ms-amber-warning: #D83B01;
            --ms-danger-red: #E81123;
            
            --bg-dark: #0B132B;
            --bg-card: rgba(17, 28, 56, 0.88);
            --card-border: rgba(0, 164, 239, 0.22);
            --card-border-hover: rgba(0, 164, 239, 0.55);
            --accent-cyan: #00A4EF;
            --accent-blue: #0078D4;
            --accent-green: #107C41;
            --accent-amber: #F59E0B;
            --accent-rose: #E81123;
            --text-main: #F3F4F6;
            --text-sub: #9CA3AF;
            --text-muted: #6B7280;
            --shadow-double: 0 20px 45px -10px rgba(0, 0, 0, 0.75), 0 0 25px rgba(0, 164, 239, 0.12);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        
        body {
            font-family: 'Segoe UI', 'Outfit', 'Plus Jakarta Sans', sans-serif;
            background: var(--ms-navy-dark);
            background-image: 
                radial-gradient(at 10% 10%, rgba(0, 164, 239, 0.15) 0px, transparent 40%),
                radial-gradient(at 90% 90%, rgba(0, 120, 212, 0.18) 0px, transparent 45%),
                radial-gradient(at 50% 50%, rgba(16, 124, 65, 0.08) 0px, transparent 55%);
            background-attachment: fixed;
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        /* Microsoft Defender Ambient Glow Orbs */
        .ambient-orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(100px);
            z-index: -1;
            pointer-events: none;
            opacity: 0.55;
            animation: floatOrb 20s infinite ease-in-out alternate;
        }
        .ambient-orb-1 { width: 550px; height: 550px; background: rgba(0, 164, 239, 0.16); top: -120px; left: -100px; }
        .ambient-orb-2 { width: 650px; height: 650px; background: rgba(0, 120, 212, 0.18); bottom: -160px; right: -140px; animation-delay: -10s; }

        @@keyframes floatOrb {
            0% { transform: translateY(0px) scale(1); }
            50% { transform: translateY(-25px) scale(1.06); }
            100% { transform: translateY(25px) scale(0.96); }
        }

        /* Microsoft Fluent Header & Navigation Bar */
        .navbar {
            background: rgba(11, 19, 43, 0.92);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--card-border);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6), inset 0 -1px 0 rgba(0, 164, 239, 0.2);
            padding: 0.75rem 2.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .navbar-left {
            display: flex;
            align-items: center;
            gap: 1.25rem;
        }

        /* Microsoft 365 Waffle Icon */
        .ms-waffle-btn {
            width: 38px;
            height: 38px;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #00A4EF;
            font-size: 1.1rem;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .ms-waffle-btn:hover { background: rgba(0, 164, 239, 0.2); border-color: #00A4EF; color: #fff; }

        .navbar-brand {
            font-size: 1.25rem;
            font-weight: 700;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 0.85rem;
            text-decoration: none;
            letter-spacing: -0.01em;
        }

        .navbar-brand-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #0078D4 0%, #00A4EF 100%);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 1.2rem;
            box-shadow: 0 4px 16px rgba(0, 120, 212, 0.45);
        }

        .nav-links {
            display: flex;
            gap: 0.75rem;
            align-items: center;
        }

        .nav-link {
            color: var(--text-sub);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.86rem;
            padding: 0.55rem 1rem;
            border-radius: 8px;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            border: 1px solid transparent;
        }

        .nav-link:hover, .nav-link.active {
            color: #fff;
            background: rgba(0, 164, 239, 0.12);
            border-color: rgba(0, 164, 239, 0.3);
            box-shadow: 0 4px 12px rgba(0, 164, 239, 0.15);
        }

        /* Container */
        .container {
            max-width: 1480px;
            margin: 1.8rem auto;
            padding: 0 2rem;
            width: 100%;
            flex: 1;
            animation: fadeIn 0.35s ease-in-out;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Microsoft Defender Acrylic Card Canvas */
        .card {
            background: linear-gradient(135deg, rgba(17, 28, 56, 0.9) 0%, rgba(12, 20, 42, 0.95) 100%);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--card-border);
            border-radius: 14px;
            padding: 1.6rem;
            margin-bottom: 1.6rem;
            box-shadow: var(--shadow-double);
            position: relative;
            overflow: hidden;
            transition: all 0.25s ease;
        }

        .card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 2px;
            background: linear-gradient(90deg, #0078D4 0%, #00A4EF 50%, #107C41 100%);
            opacity: 0.85;
        }

        .card:hover {
            border-color: var(--card-border-hover);
            box-shadow: 0 25px 50px -10px rgba(0, 0, 0, 0.85), 0 0 30px rgba(0, 164, 239, 0.2);
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.25rem;
            border-bottom: 1px solid var(--card-border);
            padding-bottom: 0.85rem;
        }

        .card-title {
            font-size: 1.15rem;
            font-weight: 700;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 0.65rem;
        }

        /* Grid */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.4rem;
            margin-bottom: 1.6rem;
        }

        /* Microsoft Defender Status Badges */
        .badge {
            padding: 0.32rem 0.8rem;
            border-radius: 6px;
            font-size: 0.74rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            letter-spacing: 0.02em;
            text-transform: uppercase;
        }
        .badge-success { background: rgba(16, 124, 65, 0.2); color: #34D399; border: 1px solid rgba(16, 124, 65, 0.5); }
        .badge-warning { background: rgba(216, 59, 1, 0.2); color: #FBBF24; border: 1px solid rgba(216, 59, 1, 0.5); }
        .badge-danger { background: rgba(232, 17, 35, 0.2); color: #F87171; border: 1px solid rgba(232, 17, 35, 0.5); }

        /* Tables */
        table { width: 100%; border-collapse: separate; border-spacing: 0; margin-top: 0.4rem; }
        th {
            text-align: left;
            padding: 0.85rem 1.1rem;
            background: rgba(11, 19, 43, 0.95);
            color: var(--accent-cyan);
            font-size: 0.76rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            border-top: 1px solid var(--card-border);
            border-bottom: 2px solid var(--card-border);
        }
        th:first-child { border-top-left-radius: 8px; }
        th:last-child { border-top-right-radius: 8px; }
        td {
            padding: 0.95rem 1.1rem;
            border-bottom: 1px solid rgba(0, 164, 239, 0.1);
            font-size: 0.9rem;
            color: var(--text-main);
            vertical-align: middle;
            transition: background 0.2s ease;
        }
        tr:hover td { background: rgba(0, 164, 239, 0.05); }

        /* Microsoft Fluent Buttons */
        .btn {
            padding: 0.65rem 1.25rem;
            border-radius: 8px;
            font-weight: 700;
            font-size: 0.86rem;
            cursor: pointer;
            border: none;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.55rem;
            text-decoration: none;
        }
        .btn:active { transform: scale(0.98); }

        .btn-primary {
            background: linear-gradient(135deg, #0078D4 0%, #00A4EF 100%);
            color: #fff;
            box-shadow: 0 4px 14px rgba(0, 120, 212, 0.4);
        }
        .btn-primary:hover {
            background: linear-gradient(135deg, #106EBE 0%, #0078D4 100%);
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(0, 120, 212, 0.55);
        }

        .btn-secondary {
            background: rgba(28, 41, 81, 0.7);
            color: var(--text-main);
            border: 1px solid var(--card-border);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
        }
        .btn-secondary:hover {
            background: rgba(0, 164, 239, 0.15);
            border-color: rgba(0, 164, 239, 0.5);
            color: #fff;
        }

        footer {
            text-align: center;
            padding: 1.8rem;
            color: var(--text-muted);
            font-size: 0.82rem;
            border-top: 1px solid var(--card-border);
            background: rgba(11, 19, 43, 0.95);
            margin-top: 3rem;
        }
    </style>
</head>
<body>
    <div class="ambient-orb ambient-orb-1"></div>
    <div class="ambient-orb ambient-orb-2"></div>

    <nav class="navbar">
        <div class="navbar-left">
            <div class="ms-waffle-btn" title="Microsoft 365 App Launcher"><i class="fa-solid fa-border-all"></i></div>
            <a href="/Admin" class="navbar-brand">
                <div class="navbar-brand-icon"><i class="fa-solid fa-shield-halved"></i></div>
                <div>
                    <div style="color: #fff;">Bkran Group Connect</div>
                    <div style="font-size: 0.7rem; font-weight: 600; color: #00A4EF; letter-spacing: 0.06em;">Microsoft 365 Enterprise Standard</div>
                </div>
            </a>
        </div>
        <div class="nav-links">
            <a href="/Admin" class="nav-link"><i class="fa-solid fa-layer-group"></i> Admin Center</a>
            <a href="/Manager" class="nav-link"><i class="fa-solid fa-user-shield"></i> Manager Console</a>
            <a href="/Auth/Logout" class="btn btn-secondary" style="padding: 0.45rem 0.9rem; font-size: 0.8rem; border-color: rgba(232, 17, 35, 0.4); color: #F87171;"><i class="fa-solid fa-right-from-bracket"></i> Logout & Switch Profile</a>
        </div>
    </nav>

    <div class="container">
        @RenderBody()
    </div>

    <footer>
        <p>&copy; 2026 Bkran Group Connect | Microsoft Ecosystem Enterprise Grade | India Regional Offices</p>
    </footer>
</body>
</html>
