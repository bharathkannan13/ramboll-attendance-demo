<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bkran Group Connect</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        :root {
            --bg-dark: #070C18;
            --bg-card: rgba(18, 26, 47, 0.75);
            --card-border: rgba(255, 255, 255, 0.08);
            --card-border-glow: rgba(59, 130, 246, 0.3);
            --accent-cyan: #00E5FF;
            --accent-blue: #3B82F6;
            --accent-green: #10B981;
            --accent-amber: #F59E0B;
            --accent-rose: #F43F5E;
            --text-main: #F8FAFC;
            --text-sub: #94A3B8;
            --text-muted: #64748B;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg-dark);
            background-image: 
                radial-gradient(at 10% 10%, rgba(59, 130, 246, 0.12) 0px, transparent 50%),
                radial-gradient(at 90% 90%, rgba(16, 185, 129, 0.08) 0px, transparent 50%);
            background-attachment: fixed;
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        /* Top Bar Navigation */
        .navbar {
            background: rgba(11, 19, 43, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--card-border);
            padding: 0.9rem 2.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .navbar-brand {
            font-size: 1.3rem;
            font-weight: 800;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 0.85rem;
            text-decoration: none;
            letter-spacing: -0.02em;
        }

        .navbar-brand-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #3B82F6 0%, #00E5FF 100%);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 1.2rem;
            box-shadow: 0 4px 15px rgba(0, 229, 255, 0.3);
        }

        .nav-links {
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        .nav-link {
            color: var(--text-sub);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.88rem;
            padding: 0.55rem 1rem;
            border-radius: 10px;
            transition: all 0.25s ease;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .nav-link:hover, .nav-link.active {
            color: #fff;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        /* Container */
        .container {
            max-width: 1440px;
            margin: 2rem auto;
            padding: 0 2rem;
            width: 100%;
            flex: 1;
            animation: fadeIn 0.4s ease-in-out;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Enterprise Glassmorphic Card */
        .card {
            background: var(--bg-card);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--card-border);
            border-radius: 16px;
            padding: 1.6rem;
            margin-bottom: 1.75rem;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
            transition: border-color 0.25s ease;
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.25rem;
            border-bottom: 1px solid var(--card-border);
            padding-bottom: 0.85rem;
        }

        .card-title {
            font-size: 1.15rem;
            font-weight: 700;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 0.65rem;
            letter-spacing: -0.01em;
        }

        /* Grid */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.5rem;
            margin-bottom: 1.75rem;
        }

        /* Status Badges */
        .badge {
            padding: 0.3rem 0.75rem;
            border-radius: 20px;
            font-size: 0.76rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            letter-spacing: 0.02em;
        }
        .badge-success { background: rgba(16, 185, 129, 0.15); color: #34D399; border: 1px solid rgba(16, 185, 129, 0.35); }
        .badge-warning { background: rgba(245, 158, 11, 0.15); color: #FBBF24; border: 1px solid rgba(245, 158, 11, 0.35); }
        .badge-danger { background: rgba(244, 63, 94, 0.15); color: #FB7185; border: 1px solid rgba(244, 63, 94, 0.35); }

        /* Tables */
        table { width: 100%; border-collapse: collapse; margin-top: 0.5rem; }
        th {
            text-align: left;
            padding: 0.85rem 1.1rem;
            background: rgba(15, 23, 42, 0.7);
            color: var(--text-sub);
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            border-bottom: 1px solid var(--card-border);
        }
        td {
            padding: 0.95rem 1.1rem;
            border-bottom: 1px solid var(--card-border);
            font-size: 0.9rem;
            color: var(--text-main);
            vertical-align: middle;
        }
        tr:hover { background: rgba(255, 255, 255, 0.025); }

        /* Buttons */
        .btn {
            padding: 0.65rem 1.25rem;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.85rem;
            cursor: pointer;
            border: none;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            display: inline-flex;
            align-items: center;
            gap: 0.55rem;
            text-decoration: none;
        }
        .btn-primary {
            background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
            color: #fff;
            box-shadow: 0 4px 14px rgba(59, 130, 246, 0.35);
        }
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(59, 130, 246, 0.5);
        }
        .btn-secondary {
            background: rgba(255, 255, 255, 0.06);
            color: var(--text-main);
            border: 1px solid var(--card-border);
        }
        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.12);
            transform: translateY(-2px);
        }

        footer {
            text-align: center;
            padding: 1.75rem;
            color: var(--text-muted);
            font-size: 0.85rem;
            border-top: 1px solid var(--card-border);
            background: rgba(7, 12, 24, 0.9);
            margin-top: 3rem;
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <a href="/" class="navbar-brand">
            <div class="navbar-brand-icon"><i class="fa-solid fa-cube"></i></div>
            <div>
                <div>Bkran Group Connect</div>
                <div style="font-size: 0.72rem; font-weight: 500; color: var(--text-sub);">Enterprise Attendance Analytics</div>
            </div>
        </a>
        <div class="nav-links">
            <a href="/Admin" class="nav-link"><i class="fa-solid fa-layer-group"></i> Admin Dashboard</a>
            <a href="/Manager" class="nav-link"><i class="fa-solid fa-users-viewfinder"></i> Manager Dashboard</a>
            <a href="/Auth/Login" class="btn btn-secondary"><i class="fa-solid fa-arrow-right-to-bracket"></i> Switch Profile</a>
        </div>
    </nav>

    <div class="container">
        @RenderBody()
    </div>

    <footer>
        <p>&copy; 2026 Bkran Group Connect | Confidential Enterprise Solution | India Region Only</p>
    </footer>
</body>
</html>
