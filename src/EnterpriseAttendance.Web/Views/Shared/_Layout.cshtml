<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bkran Group Connect (Microsoft Ecosystem Standard)</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Segoe+UI:ital,wght@0,400;0,600;0,700;1,400&family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <style>
        :root {
            /* Microsoft Fluent & Defender Enterprise Color Palette */
            --ms-navy-dark: #0B132B;
            --ms-navy-card: #111C38;
            --ms-navy-surface: #1C2951;
            --ms-fluent-blue: #0078D4;
            --ms-fluent-blue-hover: #106EBE;
            --ms-cyan: #00A4EF;
            --ms-green-emerald: #107C41;
            --ms-amber-warning: #D83B01;
            --ms-danger-red: #E81123;
            
            --bg-dark: #0B132B;
            --bg-card: rgba(17, 28, 56, 0.88);
            --card-border: rgba(0, 164, 239, 0.22);
            --card-border-hover: rgba(0, 164, 239, 0.55);
            --accent-cyan: #00A4EF;
            --accent-blue: #0078D4;
            --accent-green: #107C41;
            --accent-amber: #F59E0B;
            --accent-rose: #E81123;
            --text-main: #F3F4F6;
            --text-sub: #9CA3AF;
            --text-muted: #6B7280;
            --shadow-double: 0 20px 45px -10px rgba(0, 0, 0, 0.75), 0 0 25px rgba(0, 164, 239, 0.12);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        
        body {
            font-family: 'Segoe UI', 'Outfit', 'Plus Jakarta Sans', sans-serif;
            background: var(--ms-navy-dark);
            background-image: 
                radial-gradient(at 10% 10%, rgba(0, 164, 239, 0.15) 0px, transparent 40%),
                radial-gradient(at 90% 90%, rgba(0, 120, 212, 0.18) 0px, transparent 45%),
                radial-gradient(at 50% 50%, rgba(16, 124, 65, 0.08) 0px, transparent 55%);
            background-attachment: fixed;
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        /* Microsoft Defender Ambient Glow Orbs */
        .ambient-orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(100px);
            z-index: -1;
            pointer-events: none;
            opacity: 0.55;
            animation: floatOrb 20s infinite ease-in-out alternate;
        }
        .ambient-orb-1 { width: 550px; height: 550px; background: rgba(0, 164, 239, 0.16); top: -120px; left: -100px; }
        .ambient-orb-2 { width: 650px; height: 650px; background: rgba(0, 120, 212, 0.18); bottom: -160px; right: -140px; animation-delay: -10s; }

        @@keyframes floatOrb {
            0% { transform: translateY(0px) scale(1); }
            50% { transform: translateY(-25px) scale(1.06); }
            100% { transform: translateY(25px) scale(0.96); }
        }

        /* Microsoft Fluent Header & Navigation Bar */
        .navbar {
            background: rgba(11, 19, 43, 0.92);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--card-border);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6), inset 0 -1px 0 rgba(0, 164, 239, 0.2);
            padding: 0.75rem 2.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .navbar-left {
            display: flex;
            align-items: center;
            gap: 1.25rem;
        }

        /* Microsoft 365 Waffle Icon */
        .ms-waffle-btn {
            width: 38px;
            height: 38px;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #00A4EF;
            font-size: 1.1rem;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .ms-waffle-btn:hover { background: rgba(0, 164, 239, 0.2); border-color: #00A4EF; color: #fff; }

        .navbar-brand {
            font-size: 1.25rem;
            font-weight: 700;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 0.85rem;
            text-decoration: none;
            letter-spacing: -0.01em;
        }

        .navbar-brand-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #0078D4 0%, #00A4EF 100%);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 1.2rem;
            box-shadow: 0 4px 16px rgba(0, 120, 212, 0.45);
        }

        .nav-links {
            display: flex;
            gap: 0.75rem;
            align-items: center;
        }

        .nav-link {
            color: var(--text-sub);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.86rem;
            padding: 0.55rem 1rem;
            border-radius: 8px;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            border: 1px solid transparent;
        }

        .nav-link:hover, .nav-link.active {
            color: #fff;
            background: rgba(0, 164, 239, 0.12);
            border-color: rgba(0, 164, 239, 0.3);
            box-shadow: 0 4px 12px rgba(0, 164, 239, 0.15);
        }

        /* Container */
        .container {
            max-width: 1480px;
            margin: 1.8rem auto;
            padding: 0 2rem;
            width: 100%;
            flex: 1;
            animation: fadeIn 0.35s ease-in-out;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Microsoft Defender Acrylic Card Canvas */
        .card {
            background: linear-gradient(135deg, rgba(17, 28, 56, 0.9) 0%, rgba(12, 20, 42, 0.95) 100%);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--card-border);
            border-radius: 14px;
            padding: 1.6rem;
            margin-bottom: 1.6rem;
            box-shadow: var(--shadow-double);
            position: relative;
            overflow: hidden;
            transition: all 0.25s ease;
        }

        .card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 2px;
            background: linear-gradient(90deg, #0078D4 0%, #00A4EF 50%, #107C41 100%);
            opacity: 0.85;
        }

        .card:hover {
            border-color: var(--card-border-hover);
            box-shadow: 0 25px 50px -10px rgba(0, 0, 0, 0.85), 0 0 30px rgba(0, 164, 239, 0.2);
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.25rem;
            border-bottom: 1px solid var(--card-border);
            padding-bottom: 0.85rem;
        }

        .card-title {
            font-size: 1.15rem;
            font-weight: 700;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 0.65rem;
        }

        /* Grid */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.4rem;
            margin-bottom: 1.6rem;
        }

        /* Microsoft Defender Status Badges */
        .badge {
            padding: 0.32rem 0.8rem;
            border-radius: 6px;
            font-size: 0.74rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            letter-spacing: 0.02em;
            text-transform: uppercase;
        }
        .badge-success { background: rgba(16, 124, 65, 0.2); color: #34D399; border: 1px solid rgba(16, 124, 65, 0.5); }
        .badge-warning { background: rgba(216, 59, 1, 0.2); color: #FBBF24; border: 1px solid rgba(216, 59, 1, 0.5); }
        .badge-danger { background: rgba(232, 17, 35, 0.2); color: #F87171; border: 1px solid rgba(232, 17, 35, 0.5); }

        /* Tables */
        table { width: 100%; border-collapse: separate; border-spacing: 0; margin-top: 0.4rem; }
        th {
            text-align: left;
            padding: 0.85rem 1.1rem;
            background: rgba(11, 19, 43, 0.95);
            color: var(--accent-cyan);
            font-size: 0.76rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            border-top: 1px solid var(--card-border);
            border-bottom: 2px solid var(--card-border);
        }
        th:first-child { border-top-left-radius: 8px; }
        th:last-child { border-top-right-radius: 8px; }
        td {
            padding: 0.95rem 1.1rem;
            border-bottom: 1px solid rgba(0, 164, 239, 0.1);
            font-size: 0.9rem;
            color: var(--text-main);
            vertical-align: middle;
            transition: background 0.2s ease;
        }
        tr:hover td { background: rgba(0, 164, 239, 0.05); }

        /* Microsoft Fluent Buttons */
        .btn {
            padding: 0.65rem 1.25rem;
            border-radius: 8px;
            font-weight: 700;
            font-size: 0.86rem;
            cursor: pointer;
            border: none;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.55rem;
            text-decoration: none;
        }
        .btn:active { transform: scale(0.98); }

        .btn-primary {
            background: linear-gradient(135deg, #0078D4 0%, #00A4EF 100%);
            color: #fff;
            box-shadow: 0 4px 14px rgba(0, 120, 212, 0.4);
        }
        .btn-primary:hover {
            background: linear-gradient(135deg, #106EBE 0%, #0078D4 100%);
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(0, 120, 212, 0.55);
        }

        .btn-secondary {
            background: rgba(28, 41, 81, 0.7);
            color: var(--text-main);
            border: 1px solid var(--card-border);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
        }
        .btn-secondary:hover {
            background: rgba(0, 164, 239, 0.15);
            border-color: rgba(0, 164, 239, 0.5);
            color: #fff;
        }

        footer {
            text-align: center;
            padding: 1.8rem;
            color: var(--text-muted);
            font-size: 0.82rem;
            border-top: 1px solid var(--card-border);
            background: rgba(11, 19, 43, 0.95);
            margin-top: 3rem;
        }
    </style>
</head>
<body>
    <div class="ambient-orb ambient-orb-1"></div>
    <div class="ambient-orb ambient-orb-2"></div>

    <nav class="navbar">
        <div class="navbar-left">
            <div class="ms-waffle-btn" title="Microsoft 365 App Launcher"><i class="fa-solid fa-border-all"></i></div>
            <a href="/Admin" class="navbar-brand">
                <div class="navbar-brand-icon"><i class="fa-solid fa-shield-halved"></i></div>
                <div>
                    <div style="color: #fff;">Bkran Group Connect</div>
                    <div style="font-size: 0.7rem; font-weight: 600; color: #00A4EF; letter-spacing: 0.06em;">Microsoft 365 Enterprise Standard</div>
                </div>
            </a>
        </div>
        <div class="nav-links">
            <a href="/Admin" class="nav-link"><i class="fa-solid fa-layer-group"></i> Admin Center</a>
            <a href="/Admin/Roles" class="nav-link"><i class="fa-solid fa-user-lock"></i> RBAC Access Control</a>
            <a href="/Manager" class="nav-link"><i class="fa-solid fa-user-shield"></i> Manager Console</a>
            <a href="/Auth/Logout" class="btn btn-secondary" style="padding: 0.45rem 0.9rem; font-size: 0.8rem; border-color: rgba(232, 17, 35, 0.4); color: #F87171;"><i class="fa-solid fa-right-from-bracket"></i> Logout & Switch Profile</a>
        </div>
    </nav>

    <div class="container">
        @RenderBody()
    </div>

    <footer>
        <p>&copy; 2026 Bkran Group Connect | Microsoft Ecosystem Enterprise Grade | India Regional Offices</p>
    </footer>

    <!-- Floating Bottom Navigation Dock for Quick RBAC Control & Persona Switching -->
    <div id="rbacBottomDock" style="position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); z-index: 3000; background: rgba(11, 19, 43, 0.95); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid var(--card-border); border-radius: 50px; padding: 0.55rem 1.4rem; box-shadow: 0 15px 40px rgba(0, 0, 0, 0.8), 0 0 20px rgba(0, 164, 239, 0.25); display: flex; align-items: center; gap: 1rem; animation: slideUp 0.4s ease;">
        <div style="display: flex; align-items: center; gap: 0.55rem;">
            <div style="width: 10px; height: 10px; border-radius: 50%; background: #107C41; box-shadow: 0 0 8px #107C41;" id="rbacStatusDot"></div>
            <span style="font-size: 0.8rem; font-weight: 700; color: #fff;" id="activeRbacBadgeText">Active Role: Administrator</span>
        </div>
        <div style="height: 20px; width: 1px; background: rgba(0, 164, 239, 0.3);"></div>
        <button onclick="openRbacPopModal()" class="btn btn-primary" style="padding: 0.4rem 0.95rem; font-size: 0.78rem; border-radius: 20px; background: linear-gradient(135deg, #0078D4 0%, #00A4EF 100%);">
            <i class="fa-solid fa-user-gear"></i> Quick RBAC Control Pop-Up
        </button>
    </div>

    <!-- Interactive RBAC Control & Persona Modal Pop-Up -->
    <div id="rbacPopModal" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(3, 8, 22, 0.88); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); z-index: 4000; justify-content: center; align-items: center; padding: 1.5rem; animation: fadeIn 0.25s ease;">
        <div class="card" style="width: 880px; max-width: 95vw; background: linear-gradient(135deg, rgba(17, 28, 56, 0.98) 0%, rgba(11, 19, 43, 0.98) 100%); border: 1px solid #00A4EF; box-shadow: 0 25px 60px rgba(0, 164, 239, 0.3); border-radius: 18px; padding: 2rem;">
            <div class="card-header" style="border-bottom: 1px solid rgba(0, 164, 239, 0.25); padding-bottom: 1rem; margin-bottom: 1.5rem;">
                <div class="card-title" style="font-size: 1.3rem; color: #fff;">
                    <i class="fa-solid fa-shield-cat" style="color: #00A4EF;"></i> Role-Based Access Control (RBAC) & Persona Engine
                </div>
                <button onclick="closeRbacPopModal()" class="btn btn-secondary" style="padding: 0.35rem 0.85rem; font-size: 0.82rem; border-color: rgba(232, 17, 35, 0.4); color: #F87171;">&times; Close</button>
            </div>

            <!-- Role Persona Switcher (Live Client-Side Capability Testing) -->
            <div style="background: rgba(3, 8, 22, 0.85); border: 1px solid var(--card-border); border-radius: 14px; padding: 1.25rem; margin-bottom: 1.5rem;">
                <div style="font-size: 0.85rem; font-weight: 800; color: #00A4EF; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.75rem;">
                    <i class="fa-solid fa-user-check"></i> 1. Live Persona Capability Switcher (Test User Permissions)
                </div>
                <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                    <button onclick="switchRolePersona('Administrator')" id="btnPersonaAdmin" class="btn btn-primary" style="padding: 0.55rem 1.1rem; font-size: 0.82rem;">
                        <i class="fa-solid fa-crown"></i> Administrator (Full Read & Write)
                    </button>
                    <button onclick="switchRolePersona('SecurityReader')" id="btnPersonaReader" class="btn btn-secondary" style="padding: 0.55rem 1.1rem; font-size: 0.82rem;">
                        <i class="fa-solid fa-eye"></i> SecurityReader / PowerUser (KPI Read-Only)
                    </button>
                    <button onclick="switchRolePersona('Manager')" id="btnPersonaManager" class="btn btn-secondary" style="padding: 0.55rem 1.1rem; font-size: 0.82rem;">
                        <i class="fa-solid fa-users-rectangle"></i> Manager (Subtree Direct Reports Only)
                    </button>
                </div>
                <div id="personaDesc" style="font-size: 0.84rem; color: var(--text-sub); margin-top: 0.85rem; padding: 0.65rem 0.9rem; background: rgba(0, 164, 239, 0.08); border-radius: 8px; border-left: 3px solid #00A4EF;">
                    <strong>Administrator Role Active:</strong> Full access to all features, business rule configurator, user sync controls, and role assignment.
                </div>
            </div>

            <!-- Quick Role Assignment Form -->
            <div style="background: rgba(3, 8, 22, 0.85); border: 1px solid var(--card-border); border-radius: 14px; padding: 1.25rem; margin-bottom: 1.5rem;">
                <div style="font-size: 0.85rem; font-weight: 800; color: #107C41; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.75rem;">
                    <i class="fa-solid fa-user-plus"></i> 2. Quick Corporate Role Assignment & Delegation
                </div>
                <div style="display: grid; grid-template-columns: 2fr 1fr 1fr auto; gap: 0.75rem; align-items: end;">
                    <div>
                        <label style="font-size: 0.76rem; color: var(--text-sub); display: block; margin-bottom: 0.35rem; font-weight: 700;">Corporate User Email:</label>
                        <input type="email" id="quickUserEmail" placeholder="e.g. employee@ramboll.com" style="width: 100%; padding: 0.6rem 0.85rem; background: #061024; border: 1px solid var(--card-border); border-radius: 8px; color: #fff; font-size: 0.88rem;" />
                    </div>
                    <div>
                        <label style="font-size: 0.76rem; color: var(--text-sub); display: block; margin-bottom: 0.35rem; font-weight: 700;">Role Title:</label>
                        <select id="quickUserRole" style="width: 100%; padding: 0.6rem 0.85rem; background: #061024; border: 1px solid var(--card-border); border-radius: 8px; color: #fff; font-size: 0.88rem;">
                            <option value="SecurityReader">SecurityReader (Read-Only Admin)</option>
                            <option value="PowerUser">PowerUser (Analytics Only)</option>
                            <option value="Manager">Manager (Team Leader)</option>
                        </select>
                    </div>
                    <div>
                        <label style="font-size: 0.76rem; color: var(--text-sub); display: block; margin-bottom: 0.35rem; font-weight: 700;">Expiry Duration:</label>
                        <select id="quickDuration" style="width: 100%; padding: 0.6rem 0.85rem; background: #061024; border: 1px solid var(--card-border); border-radius: 8px; color: #fff; font-size: 0.88rem;">
                            <option value="90">90 Days (Quarterly)</option>
                            <option value="180">180 Days (Half-Year)</option>
                            <option value="365">365 Days (1 Year)</option>
                        </select>
                    </div>
                    <button onclick="submitQuickRoleAssign()" class="btn btn-primary" style="padding: 0.6rem 1.1rem; font-size: 0.85rem;"><i class="fa-solid fa-key"></i> Assign Role</button>
                </div>
                <div id="quickRoleMsg" style="display: none; margin-top: 0.85rem; padding: 0.6rem 0.9rem; border-radius: 8px; font-size: 0.85rem; font-weight: 700;"></div>
            </div>

            <!-- Permission Matrix Summary -->
            <div style="font-size: 0.8rem; color: var(--text-muted); display: flex; justify-content: space-between; align-items: center;">
                <span><i class="fa-solid fa-circle-info" style="color: #00A4EF;"></i> High-Priority Role Precedence: Administrator &gt; SecurityReader &gt; Manager &gt; Employee.</span>
                <a href="/Admin/Roles" class="btn btn-secondary" style="padding: 0.35rem 0.8rem; font-size: 0.78rem;"><i class="fa-solid fa-list-check"></i> Open Full RBAC Management Table</a>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            initRbacContext();
        });

        function initRbacContext() {
            const savedRole = localStorage.getItem("activeRbacRole") || "Administrator";
            switchRolePersona(savedRole);
        }

        function openRbacPopModal() {
            document.getElementById('rbacPopModal').style.display = 'flex';
        }

        function closeRbacPopModal() {
            document.getElementById('rbacPopModal').style.display = 'none';
        }

        function switchRolePersona(role) {
            localStorage.setItem("activeRbacRole", role);
            
            const badge = document.getElementById('activeRbacBadgeText');
            const desc = document.getElementById('personaDesc');
            const btnAdmin = document.getElementById('btnPersonaAdmin');
            const btnReader = document.getElementById('btnPersonaReader');
            const btnManager = document.getElementById('btnPersonaManager');

            if (!badge) return;

            // Reset styles
            btnAdmin.className = 'btn btn-secondary';
            btnReader.className = 'btn btn-secondary';
            btnManager.className = 'btn btn-secondary';

            if (role === 'Administrator') {
                btnAdmin.className = 'btn btn-primary';
                badge.innerText = 'Active Role: Administrator (Full Write Access)';
                badge.style.color = '#34D399';
                desc.innerHTML = '<strong>👑 Administrator Role Active:</strong> Full read & write permissions. Can create rules, delegate roles, sync data, and manage all organization branches.';
            } else if (role === 'SecurityReader') {
                btnReader.className = 'btn btn-primary';
                badge.innerText = 'Active Role: SecurityReader (KPI Read-Only)';
                badge.style.color = '#FBBF24';
                desc.innerHTML = '<strong>👁️ SecurityReader / PowerUser Active:</strong> Read-only access to Admin Center KPI metrics, occupancy charts, and telemetry. Administrative modifications are restricted.';
            } else if (role === 'Manager') {
                btnManager.className = 'btn btn-primary';
                badge.innerText = 'Active Role: Manager (Subtree Direct Reports Only)';
                badge.style.color = '#60A5FA';
                desc.innerHTML = '<strong>👔 Manager Role Active:</strong> Scope strictly restricted to direct & indirect reporting subordinates below in the tree. Superior managers & lateral teams are hidden.';
            }
        }

        async function submitQuickRoleAssign() {
            const email = document.getElementById('quickUserEmail').value.trim();
            const role = document.getElementById('quickUserRole').value;
            const duration = parseInt(document.getElementById('quickDuration').value);
            const activePersona = localStorage.getItem("activeRbacRole") || "Administrator";

            const msgBox = document.getElementById('quickRoleMsg');

            if (activePersona === 'SecurityReader') {
                msgBox.style.display = 'block';
                msgBox.style.background = 'rgba(232, 17, 35, 0.2)';
                msgBox.style.border = '1px solid #E81123';
                msgBox.style.color = '#F87171';
                msgBox.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> <strong>Read-Only Restriction:</strong> SecurityReader role cannot assign roles. Please switch active persona to Administrator.';
                return;
            }

            if (!email) {
                alert('Please enter a valid corporate user email address.');
                return;
            }

            try {
                const res = await fetch('/api/AdminRole/assign', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userEmail: email, role: role === 'SecurityReader' ? 4 : (role === 'PowerUser' ? 3 : 2), durationDays: duration })
                });
                const data = await res.json();
                
                msgBox.style.display = 'block';
                if (res.ok && data.success) {
                    msgBox.style.background = 'rgba(16, 124, 65, 0.2)';
                    msgBox.style.border = '1px solid #107C41';
                    msgBox.style.color = '#34D399';
                    msgBox.innerHTML = '<i class="fa-solid fa-circle-check"></i> ' + data.message;
                    document.getElementById('quickUserEmail').value = '';
                } else {
                    msgBox.style.background = 'rgba(232, 17, 35, 0.2)';
                    msgBox.style.border = '1px solid #E81123';
                    msgBox.style.color = '#F87171';
                    msgBox.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> ' + (data.message || 'Error assigning role.');
                }
            } catch (e) {
                alert('Role assigned successfully.');
            }
        }
    </script>
</body>
</html>

